# Emits LIVE_KICKOFF for the evidence module from kickoff-summary output (soccer books only).
# Run: jq -r -f gen-kickoff.jq ks.json
def names: {
  "col1-dep-cdt-2026-11-03|Deportivo Pereira": ["col1-dep-cdt|pereira", "Pereira", "Pereira v Tolima"],
  "col1-dep-cdt-2026-11-03|Draw (Deportivo Pereira vs. CD Tolima)": ["col1-dep-cdt|draw", "Pereira v Tolima, draw", "Pereira v Tolima"],
  "col1-dep-cdt-2026-11-03|CD Tolima": ["col1-dep-cdt|tolima", "Tolima", "Pereira v Tolima"],
  "ecu1-mur-man-2026-11-03|Mushuc Runa SC": ["ecu1-mur-man|mushuc", "Mushuc Runa", "Mushuc Runa v Manta"],
  "ecu1-mur-man-2026-11-03|Draw (Mushuc Runa SC vs. Manta FC)": ["ecu1-mur-man|draw", "Mushuc Runa v Manta, draw", "Mushuc Runa v Manta"],
  "ecu1-mur-man-2026-11-03|Manta FC": ["ecu1-mur-man|manta", "Manta", "Mushuc Runa v Manta"],
  "gtm-xel-mrq-2026-11-03|CSD Xelajú MC": ["gtm-xel-mrq|xelaju", "Xelajú", "Xelajú v Marquense"],
  "gtm-xel-mrq-2026-11-03|Draw (CSD Xelajú MC vs. CD Marquense)": ["gtm-xel-mrq|draw", "Xelajú v Marquense, draw", "Xelajú v Marquense"],
  "gtm-xel-mrq-2026-11-03|CD Marquense": ["gtm-xel-mrq|marquense", "Marquense", "Xelajú v Marquense"]
}[.book] // error("no label for \(.book)");
def median: sort | if length % 2 == 1 then .[(length - 1) / 2] else (.[length / 2 - 1] + .[length / 2]) / 2 end;
def r3: . * 1000 | round / 1000;
[.rows[] | select(.book | test("^(col1|ecu1|gtm)-")) | select(.before.resting != null)
  | (names) as $l
  | (.firstAfter) as $first
  | ([.marks[] | select(.s != null and .s > 55 and .s < 66)][0]) as $m60
  | ([.marks[] | select(.s != null and .s > 590)][0]) as $m600
  | (.reopen) as $reopen
  | (.settled) as $settled
  | {key: $l[0], label: $l[1], game: $l[2], start: .start[11:16], before: .before.resting, firstS: $first.s, first: $first.resting, at60s: $m60.resting, at600s: $m600.resting, reopen: $reopen, settled: $settled}] as $rows
| "/**
 * Resting dollars (bid plus ask, price times size, every level) on each soccer Yes book across its
 * `gameStartTime`, read every 2 seconds (kickoff-summary output, generated by gen-kickoff.jq):
 * `before` is the last read before the start, `first` the first read after it, then the reads
 * nearest 1 minute and 10 minutes in; `reopen` is the first read after the start with both a bid and
 * an ask, `settled` the first with them 5 cents apart or less, both from every read. Pereira v Tolima and Mushuc Runa v Manta started at 20:30 UTC,
 * Xelajú v Marquense (Guatemala Liga Nacional) at 21:00.
 */
export const LIVE_KICKOFF = {
  watched: \($rows | length),
  games: \($rows | map(.game) | unique | length),
  medianFirstShare: \($rows | map(.first / .before) | median | r3),
  medianShareAt60s: \($rows | map(.at60s / .before) | median | r3),
  medianShareAt600s: \($rows | map(.at600s / .before) | median | r3),
  emptyAtFirst: \($rows | map(select(.first == 0)) | length),
  maxFirstReadS: \($rows | map(.firstS) | max),
  rows: [
\($rows | map("    { key: \"\(.key)\", label: \"\(.label)\", game: \"\(.game)\", start: \"\(.start)\", before: \(.before), first: \(.first), firstS: \(.firstS), at60s: \(.at60s), at600s: \(.at600s), reopen: { s: \(.reopen.s), bid: \(.reopen.bid), ask: \(.reopen.ask) }, settled: { s: \(.settled.s), bid: \(.settled.bid), ask: \(.settled.ask) } },") | join("\n"))
  ],
} as const;"
